# Leadshub — local development environment variables.
#
# Copy this file to ``.env`` for local development:
#
#     cp .env.example .env
#
# ``.env`` is listed in ``.gitignore`` — never commit real secrets.
# Production deployments should set these via the hosting platform
# (systemd unit, Docker env, Fly.io secrets, Heroku config vars, etc.)
# rather than shipping a ``.env`` file.

# Enable Django debug mode and verbose error pages. Must be False in
# production — the scaffolded settings.py defaults to False when unset.
DEBUG=True

# Django secret key. The scaffolded settings.py falls back to an
# ``django-insecure-<random>`` default for local bootstrap, but you
# should set a real one here (and a different one in production).
SECRET_KEY=5Kz85LNBPLvufqwi98q_CvnxenBPsx3Rlhwr7Wqdz967fONoMXb3ucc_FQyDojUTFPw

# Comma-separated list of hostnames Django will accept. The scaffolded
# settings.py defaults to ``localhost,127.0.0.1`` when unset.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. Empty USER/PASSWORD use your local OS login
# (Homebrew Postgres). Create the database once with: createdb leadshub
DB_NAME=leadshub
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Email (invitations, sign-up confirmations). With DEBUG=True messages are
# printed to the console unless EMAIL_BACKEND is set.
#
# To see real emails while developing, use a Mailtrap sandbox inbox: it
# catches every message, so nothing reaches the actual recipients. Copy the
# username and password from the inbox's "SMTP" tab at mailtrap.io, uncomment
# these lines and check it with `make test-email TO=you@example.com`.
# Works for `make dev` and `make docker-up` (the container reads this file).
# The test suite never uses it: Django's test runner keeps mail in memory.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_HOST_USER=<inbox username>
# EMAIL_HOST_PASSWORD=<inbox password>
# EMAIL_USE_TLS=True
#
# In production set your real SMTP values instead:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=LeadsHub <no-reply@example.com>

# Redis, only for running several app processes or machines (Fly:
# docs/DEPLOY.md). Set, it holds djust's live page state and the channel
# layer; unset, both stay in memory, which is right for one process.
# REDIS_URL=redis://localhost:6379/0

# Uploads (creative library) on S3-compatible storage. Locally: RustFS in
# Docker, started with `make storage-up` (console http://localhost:9001,
# rustfsadmin / rustfsadmin). In production: your S3 bucket and keys, and
# leave AWS_S3_ENDPOINT_URL empty. Without AWS_STORAGE_BUCKET_NAME, uploads
# are kept in ./media on disk.
AWS_STORAGE_BUCKET_NAME=leadshub
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
